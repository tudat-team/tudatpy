# Data-input targets must remain usable without environment or dynamics models.
set(_tudat_raw_forbidden
    "^tudat_(ephemerides|earth_orientation|environment_setup|propagation_setup|estimation_setup|ground_stations|observation_models|estimatable_parameters|acceleration_partials|torque_partials|observation_partials|orbit_determination|propagators|aerodynamics|gravitation|relativity|system_models|electromagnetism|propulsion|mission_segments|shape_based_methods|low_thrust_trajectories|serialization)$")

if(CMAKE_SCRIPT_MODE_FILE)
    foreach(dependency IN LISTS RAW_INPUT_OUTPUT_DEPENDENCIES)
        if(dependency MATCHES "${_tudat_raw_forbidden}")
            message(FATAL_ERROR "Raw input target depends on model target: ${dependency}")
        endif()
    endforeach()
    message(STATUS "Raw input target dependency closure: ${RAW_INPUT_OUTPUT_DEPENDENCIES}")
    return()
endif()

set_property(GLOBAL PROPERTY TUDAT_RAW_FORBIDDEN_TARGETS "${_tudat_raw_forbidden}")

function(tudat_check_raw_input_output_dependencies)
    get_property(_tudat_raw_forbidden GLOBAL PROPERTY TUDAT_RAW_FORBIDDEN_TARGETS)
    set(pending tudat_input_output_raw tudat_earth_orientation_data tudat_ocean_loading_data)
    foreach(root IN LISTS pending)
        if(NOT TARGET "${root}")
            message(FATAL_ERROR "Missing data-input target: ${root}")
        endif()
    endforeach()
    set(visited "")
    while(pending)
        list(POP_FRONT pending dependency)
        if(NOT TARGET "${dependency}")
            continue()
        endif()
        get_target_property(aliased "${dependency}" ALIASED_TARGET)
        if(aliased)
            set(dependency "${aliased}")
        endif()
        if(dependency IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${dependency}")
        if(dependency MATCHES "${_tudat_raw_forbidden}")
            message(FATAL_ERROR "Data-input targets depend on model target: ${dependency}")
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(links "${dependency}" "${property}")
            if(links)
                # Conservatively examine every target in generator expressions, including
                # LINK_ONLY and configuration-dependent branches, rather than ignoring them.
                string(REGEX REPLACE "\\$<[^:<>]+:" ";" links "${links}")
                string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_:.-]*" candidates "${links}")
                foreach(candidate IN LISTS candidates)
                    if(TARGET "${candidate}")
                        list(APPEND pending "${candidate}")
                    endif()
                endforeach()
            endif()
        endforeach()
    endwhile()
    list(SORT visited)
    file(WRITE "${PROJECT_BINARY_DIR}/raw_input_output_dependencies.txt" "${visited}\n")
    if(TUDAT_BUILD_TESTS)
        add_test(NAME target_dependency_raw_input_output
            COMMAND "${CMAKE_COMMAND}" "-DRAW_INPUT_OUTPUT_DEPENDENCIES=${visited}"
                    -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    endif()
endfunction()
