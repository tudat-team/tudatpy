gfct 2 1 2e-6 -3e-6 20000101.0000 20020101.0000
trnd 2 1 4e-8 7e-8 20000101.1234 20020101.0000
acos 2 1 5e-8 -2e-8 20000101.0000 20020101.0000 1.0
asin 2 1 -6e-8 3e-8 20000101.0000 20020101.0000 1.0
acos 2 1 2e-8 4e-8 20000101.0000 20020101.0000 0.5
asin 2 1 1e-8 -5e-8 20000101.0000 20020101.0000 0.5
