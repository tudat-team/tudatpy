# Controlled analytic field; not a provider product.
product_type gravity_field
modelname controlled_temporal_c21
format icgem2.0
earth_gravity_constant 4e14
radius 8e6
max_degree 2
norm unnormalized
errors no
tide_system tide_free
end_of_head
